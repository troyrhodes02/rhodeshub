{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ADMIN_BASIC_AUTH_USER", "ADMIN_BASIC_AUTH_PASS", "DATABASE_URL", "DIRECT_URL"],
  "tasks": {
    "dev": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
